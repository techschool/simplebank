ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://simplebank.com
DB_SOURCE=postgresql://root:secret@localhost:5432/simple_bank?sslmode=disable
MIGRATION_URL=file://db/migration
HTTP_SERVER_ADDRESS=0.0.0.0:8080
GRPC_SERVER_ADDRESS=0.0.0.0:9090
TOKEN_SYMMETRIC_KEY=replace-this-with-a-32-byte-key!
ACCESS_TOKEN_DURATION=1m
REFRESH_TOKEN_DURATION=24h
REDIS_ADDRESS=0.0.0.0:6379
EMAIL_SENDER_NAME=Simple Bank
EMAIL_SENDER_ADDRESS=your-email@example.com
EMAIL_SENDER_PASSWORD=your-app-password
